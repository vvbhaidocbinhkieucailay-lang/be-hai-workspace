{
  "name": "be-hai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "KHÔNG GIAN LÀM VIỆC BÉ HAI – ứng dụng web cục bộ (localhost) một người dùng",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning app/server/src/index.mjs --open",
    "serve": "node --disable-warning=ExperimentalWarning app/server/src/index.mjs",
    "stop": "node app/server/src/stop.mjs",
    "dev": "vite --config app/client/vite.config.ts",
    "build": "tsc -p app/client/tsconfig.json && vite build --config app/client/vite.config.ts",
    "typecheck": "tsc -p app/client/tsconfig.json && tsc -p app/server/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/api.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
